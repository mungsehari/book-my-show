# Copy to .env and fill in. Never commit .env.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookmyshow
DB_USER=bookmyshow
DB_PASSWORD=change-me

# Backend
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth
# Signs access tokens. Required, at least 32 characters. The app will not start without it.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
# Comma-separated. These emails become ADMIN when they sign up.
ADMIN_EMAILS=
# Google sign-in. Leave empty to turn it off.
GOOGLE_CLIENT_ID=
